; https://editorconfig.org/

root = true

[*]
charset = utf-8
# Unix-style newlines with a newline ending every file
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 4

[{*.go,go.mod,go.sum,go.work,go.work.sum}]
indent_style = tab
indent_size = 4
